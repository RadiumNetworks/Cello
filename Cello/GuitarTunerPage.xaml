<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Cello.Tuning.GuitarTunerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="32" RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="Gitarre stimmen" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Standardstimmung E2 · A2 · D3 · G3 · B3 · E4"
                TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Center"
            Orientation="Horizontal"
            Spacing="8">
            <RadioButton x:Name="LowEStringButton" Click="StringButton_Click" Content="E2 · 82,41" GroupName="GuitarStrings" IsChecked="True" Tag="40" />
            <RadioButton x:Name="AStringButton" Click="StringButton_Click" Content="A2 · 110,00" GroupName="GuitarStrings" Tag="45" />
            <RadioButton x:Name="DStringButton" Click="StringButton_Click" Content="D3 · 146,83" GroupName="GuitarStrings" Tag="50" />
            <RadioButton x:Name="GStringButton" Click="StringButton_Click" Content="G3 · 196,00" GroupName="GuitarStrings" Tag="55" />
            <RadioButton x:Name="BStringButton" Click="StringButton_Click" Content="B3 · 246,94" GroupName="GuitarStrings" Tag="59" />
            <RadioButton x:Name="HighEStringButton" Click="StringButton_Click" Content="E4 · 329,63" GroupName="GuitarStrings" Tag="64" />
        </StackPanel>

        <Border
            Grid.Row="2"
            MaxWidth="760"
            Padding="32"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="12">
            <StackPanel VerticalAlignment="Center" Spacing="18">
                <TextBlock
                    x:Name="TargetStringText"
                    HorizontalAlignment="Center"
                    FontSize="32"
                    FontWeight="SemiBold"
                    Text="E2" />
                <TextBlock
                    x:Name="DetectedFrequencyText"
                    HorizontalAlignment="Center"
                    FontSize="20"
                    Text="Ziel: 82,41 Hz" />

                <Slider
                    x:Name="TuningSlider"
                    Margin="12,12,12,0"
                    IsHitTestVisible="False"
                    Maximum="50"
                    Minimum="-50"
                    StepFrequency="1"
                    Value="0" />

                <Grid>
                    <TextBlock HorizontalAlignment="Left" Text="zu tief" />
                    <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="gestimmt" />
                    <TextBlock HorizontalAlignment="Right" Text="zu hoch" />
                </Grid>

                <TextBlock
                    x:Name="CentsText"
                    HorizontalAlignment="Center"
                    FontSize="28"
                    FontWeight="SemiBold"
                    Text="– Cent" />
            </StackPanel>
        </Border>

        <InfoBar
            x:Name="TunerStatus"
            Grid.Row="3"
            IsClosable="False"
            IsOpen="True"
            Message="Wähle eine Saite und aktiviere das Mikrofon."
            Severity="Informational" />
    </Grid>
</Page>
