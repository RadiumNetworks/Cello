<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Cello.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Cello"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Cello"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="Cello">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <NavigationView
            x:Name="AppNavigation"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="LeftCompact"
            SelectionChanged="AppNavigation_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="AnalysisNavigationItem"
                    Content="Tonanalyse"
                    Icon="Audio"
                    Tag="analysis" />
                <NavigationViewItem
                    Content="Notation aufnehmen"
                    Icon="Document"
                    Tag="notation-recorder" />
                <NavigationViewItem
                    Content="MusicXML anzeigen"
                    Icon="OpenFile"
                    Tag="musicxml-viewer" />
                <NavigationViewItem
                    Content="Cello stimmen"
                    Icon="Repair"
                    Tag="tuner" />
                <NavigationViewItem
                    Content="Gitarre stimmen"
                    Icon="Repair"
                    Tag="guitar-tuner" />
            </NavigationView.MenuItems>
            <NavigationView.PaneFooter>
                <StackPanel
                    Width="220"
                    Margin="4,8,4,12"
                    Spacing="6">
                    <ToggleSwitch
                        x:Name="GlobalMicrophoneToggle"
                        Header="Mikrofon"
                        OffContent="Aus"
                        OnContent="Aktiv"
                        Toggled="GlobalMicrophoneToggle_Toggled" />
                    <TextBlock
                        x:Name="GlobalMicrophoneStatus"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Mikrofon ist ausgeschaltet"
                        TextWrapping="Wrap" />
                </StackPanel>
            </NavigationView.PaneFooter>
            <Frame x:Name="RootFrame" />
        </NavigationView>
    </Grid>
</Window>
